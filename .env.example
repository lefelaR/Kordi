APP_LOGIN_EMAIL=admin@kordicraftcreations.co.za
APP_LOGIN_PASSWORD=change-this-password

# Server-side URL for the Laravel API (Sanctum). Inside Docker use the api service.
API_BASE_URL=http://api:8000/api

# Local Docker database defaults
DB_HOST=db
DB_PORT=3306
DB_NAME=kordi
DB_USER=kordi
DB_PASSWORD=change-this-local-password
DB_ROOT_PASSWORD=change-this-root-password
DB_PORT_HOST=3307

# For a live database, replace DB_HOST, DB_PORT, DB_NAME, DB_USER, and DB_PASSWORD
# with the credentials supplied by your hosting provider.
# Production also needs a reverse proxy for /api → the Laravel app (same as local Docker).

# PHPMailer SMTP. Local Docker uses Mailpit when MAIL_HOST is mailpit.
# Open captured messages at http://localhost:8025.
# On a live server, set MAIL_HOST to the provider SMTP host and fill in the rest.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAILPIT_PORT=8025
DirectoryIndex index.php

RewriteEngine On

RewriteRule ^app(?:/|$) - [F,L]

# Keep existing assets and files directly accessible.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send application routes to the front controller.
RewriteRule ^ index.php [L]